# Supabase – obrigatório para o app conectar
# Coloque este conteúdo em um arquivo chamado .env na RAIZ do projeto (mesma pasta do package.json).
# Crie um projeto em https://supabase.com e pegue em: Project Settings > API
# Depois de criar/editar o .env, reinicie o servidor (npm run dev).

VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alternativa: a chave também pode se chamar VITE_SUPABASE_ANON_KEY (nome usado na doc do Supabase).

# Meta (Facebook) – para conectar contas Instagram (botão "Conectar Conta")
# Crie um app em https://developers.facebook.com e adicione o produto "Facebook Login" e "Instagram Graph API".
# No .env use só o App ID (a chave pública). O App Secret NUNCA vai no frontend.
VITE_META_APP_ID=SEU_APP_ID

# O App Secret da Meta deve ser configurado como SECRET na Edge Function (não no .env do frontend):
#   supabase secrets set META_APP_ID=SEU_APP_ID META_APP_SECRET=SEU_APP_SECRET
# Depois faça deploy: supabase functions deploy meta-connect
# No Facebook App: Facebook Login > Configurações > URIs de redirecionamento OAuth válidos:
#   https://SEU_DOMINIO/accounts/connect/callback   (e em dev: http://localhost:5173/accounts/connect/callback)
