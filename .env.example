# Supabase – obrigatório para o app conectar
# Coloque este conteúdo em um arquivo chamado .env na RAIZ do projeto (mesma pasta do package.json).
# Crie um projeto em https://supabase.com e pegue em: Project Settings > API
# Depois de criar/editar o .env, reinicie o servidor (npm run dev).

VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alternativa: a chave também pode se chamar VITE_SUPABASE_ANON_KEY (nome usado na doc do Supabase).

# Meta – para conectar contas Instagram (API oficial, sem Facebook)
# Crie um app em https://developers.facebook.com e configure "Instagram API with Instagram Login".
# No .env use só o App ID. O App Secret NUNCA vai no frontend.
VITE_META_APP_ID=SEU_APP_ID

# App Secret só na Edge Function: supabase secrets set META_APP_ID=... META_APP_SECRET=...
# Deploy: npx supabase functions deploy instagram-connect --no-verify-jwt
# No app Meta: Instagram → Set up business login → OAuth redirect URIs:
#   http://localhost:5173/accounts/connect/instagram/callback e https://SEU_DOMINIO/accounts/connect/instagram/callback

# Google Drive – para colar link da pasta/vídeo e carregar vídeos automaticamente
# Crie um projeto em https://console.cloud.google.com, ative a API "Google Drive API",
# configure a tela de consentimento OAuth e crie credenciais (tipo "Aplicativo da Web").
# No .env use só o Client ID. O Client Secret só nas Edge Functions (Supabase secrets).
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# Client Secret só na Edge Function: supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
# Redirect URI no Google Console: http://localhost:5173/new-post/drive/callback e https://reelspro-eight.vercel.app/new-post/drive/callback
